{
  "name": "sf-help-crawler",
  "version": "1.0.0",
  "description": "Salesforce Help page crawler using Playwright",
  "main": "crawl-sf-help.js",
  "scripts": {
    "crawl": "node crawl-sf-help.js",
    "crawl:shallow": "MAX_DEPTH=1 MAX_PAGES=20 node crawl-sf-help.js",
    "crawl:full": "MAX_DEPTH=3 MAX_PAGES=100 node crawl-sf-help.js"
  },
  "dependencies": {
    "playwright": "^1.45.0"
  }
}
