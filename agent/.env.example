# Anthropic API key — get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the Claude model (default: claude-haiku-4-5-20251001)
# Other options: claude-sonnet-4-5, claude-opus-4-5
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Port the agent server listens on (default: 3030)
PORT=3030
